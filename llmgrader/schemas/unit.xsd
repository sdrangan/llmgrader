<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:simpleType name="conditionTypeEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="positive"/>
      <xs:enumeration value="negative"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="actionTypeEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="fail"/>
      <xs:enumeration value="feedback"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="trueFalseEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="true"/>
      <xs:enumeration value="false"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="rubricTotalEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="sum_positive"/>
      <xs:enumeration value="sum_negative"/>
      <xs:enumeration value="flexible"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="unitTypeId">
    <xs:restriction base="xs:string">
      <xs:pattern value="[a-z][a-z0-9_-]*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="richTextType" mixed="true">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="skip"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="partType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="part_label" type="xs:string"/>
      <xs:element name="points" type="xs:decimal"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:string" use="optional"/>
    <xs:attribute name="points" type="xs:decimal" use="optional"/>
  </xs:complexType>

  <xs:complexType name="rubricItemType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="display_text" type="richTextType"/>
      <xs:element name="condition" type="richTextType"/>
      <xs:element name="notes" type="richTextType" minOccurs="0"/>
      <xs:element name="part" type="xs:string" minOccurs="0"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="part" type="xs:string" use="optional"/>
    <xs:attribute name="condition_type" type="conditionTypeEnum" use="optional"/>
    <xs:attribute name="action" type="actionTypeEnum" use="optional"/>
    <xs:attribute name="point_adjustment" type="xs:decimal" use="optional"/>
    <!-- The skill this item assesses: an id declared in the course's
         skills.xml.  Optional, and nothing consumes it yet.  Tagged on the
         item rather than the question because the grader already decides
         each item separately (rubric_eval), so a tagged item can say which
         skill a student missed, not only which skills a problem touches.

         rubric_eval is returned with every grade but is not yet stored in
         the submissions table, so no skill-level evidence accumulates until
         it is.  See plans/course_mcp.md, decision 8.

         The common wrong answers behind an item belong in its <notes> as
         prose, not in a structured field.  There is also deliberately no
         unit-level list of skills taught: a skill exists only if some
         problem assesses it, so the tags are the whole record. -->
    <xs:attribute name="skill" type="xs:token" use="optional"/>
  </xs:complexType>

  <xs:complexType name="rubricGroupType">
    <xs:sequence>
      <xs:element name="id" type="xs:string" minOccurs="2" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="type" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="questionType">
    <xs:all>
      <xs:element name="question_text" type="richTextType" minOccurs="0"/>
      <xs:element name="solution" type="richTextType" minOccurs="0"/>
      <xs:element name="grading_notes" type="richTextType" minOccurs="0"/>
      <xs:element name="required" type="trueFalseEnum" minOccurs="0"/>
      <xs:element name="partial_credit" type="xs:string" minOccurs="0"/>
      <xs:element name="rubric_total" type="rubricTotalEnum" minOccurs="0"/>
      <xs:element name="points" type="xs:decimal" minOccurs="0"/>
      <xs:element name="tool" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <!-- What an agent may safely change when generating practice variants
           of this question, and what it must hold fixed because the rubric
           keys on it.  Returned by the MCP get_question tool and ignored by
           the grader.  This is the cheapest possible stand-in for a
           PrairieLearn generator: the variants live in the student's
           conversation and are never written back, which is what keeps the
           question bank small enough to hand over whole.  See
           plans/course_mcp.md, decision 11. -->
      <xs:element name="variation_guidance" type="xs:string" minOccurs="0"/>
      <xs:element name="parts" minOccurs="1">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="part" type="partType" minOccurs="1" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="rubrics" minOccurs="0">
        <xs:complexType>
          <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="item" type="rubricItemType"/>
            <xs:element name="group" type="rubricGroupType"/>
          </xs:choice>
        </xs:complexType>
      </xs:element>
    </xs:all>
    <xs:attribute name="qtag" type="xs:string" use="required"/>
    <xs:attribute name="preferred_model" type="xs:string" use="optional"/>
  </xs:complexType>

  <!-- How a unit prints (plans/exam_units.md, decision 5): create_qfile
       print renders one block.  The grader and the course MCP never read it.
       Everything is optional; see docs/admin/buildcourse/print.md. -->
  <xs:simpleType name="printId">
    <xs:restriction base="xs:string">
      <xs:pattern value="[a-z0-9][a-z0-9_-]*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="printFieldsType">
    <xs:sequence>
      <xs:element name="field" type="xs:string" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="printInstructionsType">
    <xs:sequence>
      <xs:element name="item" type="richTextType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="titlePageType">
    <xs:all>
      <xs:element name="title" type="xs:string" minOccurs="0"/>
      <xs:element name="course" type="xs:string" minOccurs="0"/>
      <xs:element name="instructors" type="xs:string" minOccurs="0"/>
      <xs:element name="date" type="xs:string" minOccurs="0"/>
      <xs:element name="duration" type="xs:string" minOccurs="0"/>
      <xs:element name="fields" type="printFieldsType" minOccurs="0"/>
      <xs:element name="instructions" type="printInstructionsType" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <!-- One printed question, in printed order.  qtag must be a question of
       this unit (checked by UnitParser, not here). -->
  <xs:complexType name="printQuestionType">
    <xs:attribute name="qtag" type="xs:string" use="required"/>
    <xs:attribute name="answer_pages" type="xs:nonNegativeInteger" use="optional"/>
  </xs:complexType>

  <xs:complexType name="printType">
    <xs:sequence>
      <xs:element name="title_page" type="titlePageType" minOccurs="0"/>
      <xs:element name="question" type="printQuestionType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="printId" use="required"/>
    <xs:attribute name="answer_pages" type="xs:nonNegativeInteger" use="optional"/>
    <xs:attribute name="page_per_question" type="trueFalseEnum" use="optional"/>
  </xs:complexType>

  <xs:element name="unit">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="digitalsign" type="trueFalseEnum" minOccurs="0"/>
        <xs:element name="question" type="questionType" minOccurs="0" maxOccurs="unbounded"/>
        <!-- After every question, so the questions stay contiguous. -->
        <xs:element name="print" type="printType" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="optional"/>
      <xs:attribute name="title" type="xs:string" use="optional"/>
      <xs:attribute name="version" type="xs:string" use="optional"/>
      <!-- What kind of unit this is: problem_set (the default), midterm,
           final, quiz; a course names its own.  A key, so constrained.
           The course MCP reports it; the grader ignores it. -->
      <xs:attribute name="unit_type" type="unitTypeId" use="optional"/>
      <!-- When past material was given, as free text ("Spring 2026"). -->
      <xs:attribute name="semester" type="xs:string" use="optional"/>
    </xs:complexType>
    <xs:unique name="uniquePrintId">
      <xs:selector xpath="print"/>
      <xs:field xpath="@id"/>
    </xs:unique>
  </xs:element>
</xs:schema>