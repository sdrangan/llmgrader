<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="llmgrader">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="course">
          <xs:complexType>
            <xs:sequence>
              <!-- Optional machine-facing course identifier.  It names a
                   directory under <storage>/courses/ and, later, a URL path
                   segment, so the pattern is deliberately narrow: lowercase
                   only (two courses must not differ by case alone on a
                   case-insensitive filesystem), no dots or slashes (rules out
                   "." and ".." as path segments), alphanumeric first
                   character, 64 characters at most.

                   Optional for one release: every course package authored
                   before this field existed must still validate, and the boot
                   migration in CourseRegistry runs against exactly such a
                   package.  When it is absent the id is derived once from
                   <name> + <semester> and recorded in courses.json.
                   See plans/multicourse.md, decision 3. -->
              <xs:element name="course_id" minOccurs="0">
                <xs:simpleType>
                  <xs:restriction base="xs:token">
                    <xs:pattern value="[a-z0-9][a-z0-9_-]{0,63}"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="name" type="xs:token"/>
              <xs:choice>
                <xs:element name="semester" type="xs:token"/>
                <xs:element name="term" type="xs:token"/>
              </xs:choice>
              <!-- Optional banner text. <title> overrides the headline shown in
                   the page banner; without it the banner falls back to <name>.
                   <instructors> is the subtitle line and is omitted if absent. -->
              <xs:element name="title" type="xs:token" minOccurs="0"/>
              <xs:element name="instructors" type="xs:token" minOccurs="0"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="units">
          <xs:complexType>
            <xs:sequence>
              <xs:choice minOccurs="1" maxOccurs="unbounded">
                <xs:element name="section" type="xs:token"/>
                <xs:element name="unit">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="name" type="xs:token"/>
                      <xs:element name="source" type="xs:token"/>
                      <xs:element name="destination" type="xs:token"/>
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
              </xs:choice>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="assets" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="asset" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="source" type="xs:token"/>
                    <xs:element name="destination" type="xs:token"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
