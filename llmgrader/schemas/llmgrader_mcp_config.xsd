<?xml version="1.0" encoding="UTF-8"?>
<!-- llmgrader_mcp_config.xml: the course material the course MCP publishes
     beyond the grading package: the course's materials (lecture slides,
     demos, labs, handouts; kinds the instructor names), units the portal
     does not serve (past exams), and descriptions of each kind of unit.

     It sits beside llmgrader_config.xml, and create_soln_pkg builds what it
     lists into the course package (mcp_materials/), so one upload still
     carries everything.  Material comes from two sources, kept apart on
     purpose: the package (explicit paths only, from any repository,
     including private ones) and the mirror (the public repo <code> names,
     synced by the portal, where patterns are allowed).  See
     plans/unified_materials.md and docs/admin/mcp/package.md. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <!-- Becomes a directory name and a tool argument. -->
  <xs:simpleType name="idType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[a-z0-9][a-z0-9_-]{0,63}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- A repository the material is drawn from, by name.  path is relative to
       this file; the build can override it (the build's root option). -->
  <xs:complexType name="rootType">
    <xs:attribute name="id" type="idType" use="required"/>
    <xs:attribute name="path" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- A unit published to the course MCP only: the element text is its unit
       XML file, relative to this file (or to root).  The portal never sees
       it, so it must not also be in llmgrader_config.xml.  Its figures
       follow the portal convention: an images/ folder beside the file,
       referenced as /pkg_assets/<file stem>_images/<file>.  name defaults to
       the unit's title attribute; section groups it in list_units.  See
       plans/exam_units.md, decision 2. -->
  <xs:complexType name="mcpUnitType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="name" type="xs:string" use="optional"/>
        <xs:attribute name="section" type="xs:string" use="optional"/>
        <xs:attribute name="root" type="idType" use="optional"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- The same key as unit_type on a unit (unit.xsd). -->
  <xs:simpleType name="unitTypeId">
    <xs:restriction base="xs:string">
      <xs:pattern value="[a-z][a-z0-9_-]*"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- What a kind of unit is like, for a student's assistant: the element
       text is the description ("closed book, five minutes a problem").  It
       changes each term; the past units of that type do not. -->
  <xs:complexType name="unitTypeType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="id" type="unitTypeId" use="required"/>
        <xs:attribute name="title" type="xs:string" use="optional"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- A path inside the mirror: no leading slash, no "..", no drive. -->
  <xs:simpleType name="repoPath">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z0-9_][A-Za-z0-9_.\-]*(/[A-Za-z0-9_][A-Za-z0-9_.\-]*)*"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- A path pattern inside the mirror: the last component may hold * and ?
       ("labs/*"); the components before it are plain names. -->
  <xs:simpleType name="repoPattern">
    <xs:restriction base="xs:string">
      <xs:pattern value="([A-Za-z0-9_][A-Za-z0-9_.\-]*/)*[A-Za-z0-9_.\-*?]+"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- The public GitHub repo the mirror source syncs (plans/unified_materials.md,
       Sources).  Only the paths <materials> names with source="mirror" are
       fetched or served, minus build output, binaries, generated Tcl and
       anything an <exclude> glob matches (relative to the repo root; a glob
       without "/" matches file names).  site is where its docs pages are
       published; by default it is read from the repo's _config.yml.
       overrides names the repo's own corrections file (default
       materials.xml, schema llmgrader_materials.xsd), read on every sync.
       root names a <root> holding a local checkout, so the build can check
       the mirrored items before the portal ever syncs them. -->
  <xs:complexType name="codeType">
    <xs:sequence>
      <xs:element name="exclude" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="repo" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="https://github\.com/[A-Za-z0-9_.\-]+/[A-Za-z0-9_.\-]+/?"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="branch" use="optional" default="main">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="[A-Za-z0-9_][A-Za-z0-9_.\-/]*"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="site" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="https?://[^\s]+"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="overrides" type="repoPath" use="optional"/>
    <xs:attribute name="root" type="idType" use="optional"/>
  </xs:complexType>

  <!-- A kind of material, named by the instructor: slides, demo, lab,
       handout...  description is what a student's assistant reads about it.
       policy: open (served as is), tutor (served with the instruction to
       help the student reason toward the answer rather than hand it over),
       or private (listed by title, never read or searched; and a package
       item of a private kind is never built into the package at all). -->
  <xs:complexType name="kindType">
    <xs:attribute name="id" type="idType" use="required"/>
    <xs:attribute name="description" type="xs:string" use="required"/>
    <xs:attribute name="policy" use="optional" default="open">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="open"/>
          <xs:enumeration value="tutor"/>
          <xs:enumeration value="private"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <!-- A unit that holds material and no questions: course setup, a lecture
       with no problem set.  Items name it by id or by name; list_units
       lists it with no questions. -->
  <xs:complexType name="materialUnitType">
    <xs:attribute name="id" type="idType" use="required"/>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="description" type="xs:string" use="optional"/>
  </xs:complexType>

  <!-- One more file or folder of an item, beside its path.  path is read by
       its extension (pdf= gives a .pptx its PDF export); docs, for a mirror
       item, is a docs page or folder of pages, served with its published
       address. -->
  <xs:complexType name="partType">
    <xs:attribute name="path" type="xs:string" use="optional"/>
    <xs:attribute name="pdf" type="xs:string" use="optional"/>
    <xs:attribute name="docs" type="repoPath" use="optional"/>
  </xs:complexType>

  <!-- Slides of one deck that go with an item; without first, the deck's
       units alone. -->
  <xs:complexType name="slidesRefType">
    <xs:attribute name="deck" type="idType" use="required"/>
    <xs:attribute name="first" type="xs:positiveInteger" use="optional"/>
    <xs:attribute name="last" type="xs:positiveInteger" use="optional"/>
  </xs:complexType>

  <!-- Drop every link derived from one deck: its slides and its units. -->
  <xs:complexType name="notSlidesType">
    <xs:attribute name="deck" type="idType" use="required"/>
  </xs:complexType>

  <!-- An item: the thing a student is pointed to.

       With path, docs or a <part>, it makes one, and kind is required.
       source="package" (the default) builds its files into the package from
       a <root>, by explicit path only: a .pptx is read as slides (pdf= its
       PDF export, for the images), a .pdf page by page, a folder file by
       file, anything else as text.  source="mirror" serves them from the
       <code> repo, and docs= adds its docs pages.

       With only an id it refines an item made elsewhere (by an <items>
       pattern, or above), setting its kind, title or description and adding
       units or slides.  An id that matches no item fails the build.

       unit, also and each <unit> name a unit: a <name> from
       llmgrader_config.xml, an MCP-only unit's name, or a material <unit>
       by id or name.  Every item needs at least one. -->
  <xs:complexType name="itemType">
    <xs:sequence>
      <xs:element name="description" type="xs:string" minOccurs="0"/>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="unit" type="xs:string"/>
        <xs:element name="part" type="partType"/>
        <xs:element name="slides" type="slidesRefType"/>
        <xs:element name="not_slides" type="notSlidesType"/>
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="id" type="idType" use="required"/>
    <xs:attribute name="kind" type="idType" use="optional"/>
    <xs:attribute name="title" type="xs:string" use="optional"/>
    <xs:attribute name="unit" type="xs:string" use="optional"/>
    <xs:attribute name="also" type="xs:string" use="optional"/>
    <xs:attribute name="source" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="package"/>
          <xs:enumeration value="mirror"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="root" type="idType" use="optional"/>
    <xs:attribute name="path" type="xs:string" use="optional"/>
    <xs:attribute name="pdf" type="xs:string" use="optional"/>
    <xs:attribute name="docs" type="repoPath" use="optional"/>
  </xs:complexType>

  <!-- One item per folder name that path or docs matches in the mirror:
       labs/<name> with docs/labs/<name>.  The id is the matched name; the
       title and description come from the docs folder's index.md (front
       matter title, first paragraph).  A folder an <item> already serves
       is skipped; a name another item already has gets the kind after it
       (fsm-demo, beside the fsm slides).

       Mirror only, by design (source is fixed): the package has no patterns,
       because a course repository also holds exams, keys and solutions, and
       a new one must not be published because nobody remembered to exclude
       it.  Everything in the mirror is public already. -->
  <xs:complexType name="itemsType">
    <xs:attribute name="kind" type="idType" use="required"/>
    <xs:attribute name="source" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="mirror"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="path" type="repoPattern" use="required"/>
    <xs:attribute name="docs" type="repoPattern" use="optional"/>
    <xs:attribute name="unit" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="materialsType">
    <xs:sequence>
      <xs:element name="kind" type="kindType" maxOccurs="unbounded"/>
      <xs:element name="unit" type="materialUnitType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="item" type="itemType"/>
        <xs:element name="items" type="itemsType"/>
      </xs:choice>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="llmgrader_mcp">
    <xs:complexType>
      <xs:sequence>
        <!-- Where llmgrader_mcp_build describe writes the slide and page
             descriptions, one JSON file per deck; relative to this file.
             Default: llmgrader_mcp_descriptions/ beside it.  Commit it. -->
        <xs:element name="descriptions" minOccurs="0">
          <xs:complexType>
            <xs:attribute name="path" type="xs:string" use="required"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="roots" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="root" type="rootType" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="units" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="unit" type="mcpUnitType" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="unit_types" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="unit_type" type="unitTypeType" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="code" type="codeType" minOccurs="0"/>
        <xs:element name="materials" type="materialsType" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
    <xs:unique name="uniqueKindId">
      <xs:selector xpath="materials/kind"/>
      <xs:field xpath="@id"/>
    </xs:unique>
    <xs:unique name="uniqueMaterialUnitId">
      <xs:selector xpath="materials/unit"/>
      <xs:field xpath="@id"/>
    </xs:unique>
    <xs:unique name="uniqueUnitTypeId">
      <xs:selector xpath="unit_types/unit_type"/>
      <xs:field xpath="@id"/>
    </xs:unique>
    <xs:unique name="uniqueRootId">
      <xs:selector xpath="roots/root"/>
      <xs:field xpath="@id"/>
    </xs:unique>
  </xs:element>
</xs:schema>
