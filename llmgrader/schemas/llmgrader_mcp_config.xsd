<?xml version="1.0" encoding="UTF-8"?>
<!-- llmgrader_mcp_config.xml: the course material the course MCP publishes
     beyond the grading package: lecture slide decks, units the portal does not
     serve (past exams), and descriptions of each kind of unit.

     It sits beside llmgrader_config.xml, and create_soln_pkg builds what it
     lists into the course package (mcp_materials/), so one upload still
     carries everything.  Only what is listed here is published: there are no
     patterns, because a course repository also holds exams, autograder keys
     and lab solutions, and a new one of those must not be published because
     nobody remembered to exclude it.  See plans/course_mcp.md and
     docs/admin/mcp/package.md. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <!-- Becomes a directory name and a tool argument. -->
  <xs:simpleType name="idType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[a-z0-9][a-z0-9_-]{0,63}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- A repository the material is drawn from, by name.  path is relative to
       this file; the build can override it (the build's root option). -->
  <xs:complexType name="rootType">
    <xs:attribute name="id" type="idType" use="required"/>
    <xs:attribute name="path" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- One slide deck.  The element text is the .pptx (slide text and speaker
       notes); pdf, when given, is the same deck exported to PDF, from which
       each slide's image is rendered.  A PDF whose page count differs from
       the deck's slide count is stale, and is not used. -->
  <xs:complexType name="deckType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="id" type="idType" use="required"/>
        <!-- The unit it belongs to: a unit <name> from llmgrader_config.xml
             where there is one, or free text such as "Lab: Root Solver". -->
        <xs:attribute name="unit" type="xs:string" use="required"/>
        <xs:attribute name="title" type="xs:string" use="optional"/>
        <xs:attribute name="root" type="idType" use="optional"/>
        <xs:attribute name="pdf" type="xs:string" use="optional"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- A unit published to the course MCP only: the element text is its unit
       XML file, relative to this file (or to root).  The portal never sees
       it, so it must not also be in llmgrader_config.xml.  Its figures
       follow the portal convention: an images/ folder beside the file,
       referenced as /pkg_assets/<file stem>_images/<file>.  name defaults to
       the unit's title attribute; section groups it in list_units.  See
       plans/exam_units.md, decision 2. -->
  <xs:complexType name="mcpUnitType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="name" type="xs:string" use="optional"/>
        <xs:attribute name="section" type="xs:string" use="optional"/>
        <xs:attribute name="root" type="idType" use="optional"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- The same key as unit_type on a unit (unit.xsd). -->
  <xs:simpleType name="unitTypeId">
    <xs:restriction base="xs:string">
      <xs:pattern value="[a-z][a-z0-9_-]*"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- What a kind of unit is like, for a student's assistant: the element
       text is the description ("closed book, five minutes a problem").  It
       changes each term; the past units of that type do not. -->
  <xs:complexType name="unitTypeType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="id" type="unitTypeId" use="required"/>
        <xs:attribute name="title" type="xs:string" use="optional"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- A path inside the demo repo: no leading slash, no "..", no drive. -->
  <xs:simpleType name="repoPath">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z0-9_][A-Za-z0-9_.\-]*(/[A-Za-z0-9_][A-Za-z0-9_.\-]*)*"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- One subtree of the demo repo to publish.  kind="doc" for Markdown
       pages (only .md files are served from it), code otherwise. -->
  <xs:complexType name="codeIncludeType">
    <xs:attribute name="path" type="repoPath" use="required"/>
    <xs:attribute name="kind" use="optional" default="code">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="code"/>
          <xs:enumeration value="doc"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <!-- A public GitHub repo whose demo code and docs the MCP serves, kept in
       sync with the branch rather than built into the package: only the
       <include> paths are fetched or served, minus build output, binaries,
       generated Tcl and anything an <exclude> glob matches (relative to the
       repo root; a glob without "/" matches file names).  site is where the
       docs are published; by default it is read from the repo's
       _config.yml.  links names the overrides file (default
       demos/demos.xml).  root names a <root> holding a local checkout, for
       the build's link report.  See plans/demo_code_mcp.md. -->
  <xs:complexType name="codeType">
    <xs:sequence>
      <xs:element name="include" type="codeIncludeType" maxOccurs="unbounded"/>
      <xs:element name="exclude" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="repo" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="https://github\.com/[A-Za-z0-9_.\-]+/[A-Za-z0-9_.\-]+/?"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="branch" use="optional" default="main">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="[A-Za-z0-9_][A-Za-z0-9_.\-/]*"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="site" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="https?://[^\s]+"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="links" type="repoPath" use="optional"/>
    <xs:attribute name="root" type="idType" use="optional"/>
  </xs:complexType>

  <xs:element name="llmgrader_mcp">
    <xs:complexType>
      <xs:sequence>
        <!-- Where llmgrader_mcp_build describe writes the slide descriptions,
             one JSON file per deck; relative to this file.  Default:
             llmgrader_mcp_descriptions/ beside it.  Commit that folder. -->
        <xs:element name="descriptions" minOccurs="0">
          <xs:complexType>
            <xs:attribute name="path" type="xs:string" use="required"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="roots" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="root" type="rootType" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="slides" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="deck" type="deckType" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="units" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="unit" type="mcpUnitType" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="unit_types" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="unit_type" type="unitTypeType" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="code" type="codeType" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
    <xs:unique name="uniqueDeckId">
      <xs:selector xpath="slides/deck"/>
      <xs:field xpath="@id"/>
    </xs:unique>
    <xs:unique name="uniqueUnitTypeId">
      <xs:selector xpath="unit_types/unit_type"/>
      <xs:field xpath="@id"/>
    </xs:unique>
    <xs:unique name="uniqueRootId">
      <xs:selector xpath="roots/root"/>
      <xs:field xpath="@id"/>
    </xs:unique>
  </xs:element>
</xs:schema>
