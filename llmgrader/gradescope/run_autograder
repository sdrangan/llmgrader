#!/usr/bin/env bash
set -euo pipefail

# autograde.py reads /autograder/submission directly; nothing is copied.
# (A plain `cp submission/*` aborts under `set -e` once the zip holds a
# directory, such as images/, and Gradescope then gets no results at all.)

cd /autograder/source

# If you add dependencies later, uncomment:
# pip install -r requirements.txt

python3 autograde.py